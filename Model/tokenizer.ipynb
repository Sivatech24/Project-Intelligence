   "source": [
    "tokenizer = Tokenizer(BPE(unk_token=\"[UNK]\"))\n",
    "tokenizer.pre_tokenizer = Whitespace()\n",
    "trainer = BpeTrainer(special_tokens=[\"[UNK]\", \"[PAD]\", \"[BOS]\", \"[EOS]\"], vocab_size=32000)\n",
    "\n",
    "# 1. Create a generator to yield text in chunks (saves RAM)\n",
    "def batch_iterator(batch_size=10000):\n",
    "    with open(txt_corpus_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        batch = []\n",
    "        for line in f:\n",
    "            line = line.strip()\n",
    "            if line:\n",
    "                batch.append(line)\n",
    "            if len(batch) == batch_size:\n",
    "                yield batch\n",
    "                batch = []\n",
    "        if batch:\n",
    "            yield batch\n",
    "\n",
    "print(\"Training Tokenizer via streaming...\")\n",
    "# 2. Train using the iterator instead of the file path\n",
    "tokenizer.train_from_iterator(batch_iterator(), trainer=trainer)\n",
    "\n",
    "tokenizer.save(\"tokenizer.json\")\n",
    "print(\"Tokenizer saved!\")"
   ]
  },
