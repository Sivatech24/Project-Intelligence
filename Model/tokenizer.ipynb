   "source": [
    "urls = [\n",
    "    \"https://dumps.wikimedia.org/other/mediawiki_content_current/enwiktionary/2026-04-01/xml/bzip2/enwiktionary-2026-04-01-p7p11575490.xml.bz2\",\n",
    "    \"https://dumps.wikimedia.org/other/mediawiki_content_current/enwikiquote/2026-04-01/xml/bzip2/enwikiquote-2026-04-01-p1p305881.xml.bz2\",\n",
    "    \"https://dumps.wikimedia.org/other/mediawiki_content_current/enwikibooks/2026-04-01/xml/bzip2/enwikibooks-2026-04-01-p1p482395.xml.bz2\",\n",
    "    \"https://dumps.wikimedia.org/other/mediawiki_content_current/simplewiki/2026-04-01/xml/bzip2/simplewiki-2026-04-01-p1p1261009.xml.bz2\",                    \n",
    "]\n",
    "\n",
    "os.makedirs(\"data\", exist_ok=True)\n",
    "txt_corpus_path = \"data/corpus.txt\"\n",
    "\n",
    "def download_and_extract_text(urls, output_file):\n",
    "    \"\"\"Downloads bz2 wiki dumps and extracts basic text to a single file.\"\"\"\n",
    "    print(\"Downloading and extracting Wikipedia text...\")\n",
    "    with open(output_file, \"w\", encoding=\"utf-8\") as out_f:\n",
    "        for url in urls:\n",
    "            filename = os.path.join(\"data\", url.split('/')[-1])\n",
    "            if not os.path.exists(filename):\n",
    "                print(f\"Downloading {filename}...\")\n",
    "                urllib.request.urlretrieve(url, filename)\n",
    "            \n",
    "            print(f\"Extracting {filename}...\")\n",
    "            # Stream the bz2 file to save RAM\n",
    "            with bz2.open(filename, \"rt\", encoding=\"utf-8\") as bz2_file:\n",
    "                try:\n",
    "                    context = ET.iterparse(bz2_file, events=(\"end\",))\n",
    "                    for event, elem in context:\n",
    "                        # Find tags ending with 'text' (ignoring namespaces)\n",
    "                        if elem.tag.endswith('text') and elem.text:\n",
    "                            # Basic cleanup (in a real scenario, use mwparserfromhell)\n",
    "                            text = elem.text.strip()\n",
    "                            if len(text) > 50: # Skip tiny entries\n",
    "                                out_f.write(text + \"\\n\\n\")\n",
    "                        elem.clear() # Free memory\n",
    "                except ET.ParseError:\n",
    "                    print(f\"Reached end of valid XML in {filename}\")\n",
    "\n",
    "download_and_extract_text(urls, txt_corpus_path)"
   ]
