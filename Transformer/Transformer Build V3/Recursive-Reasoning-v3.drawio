        <mxCell id="an1" value="Add &amp; Normalize (post-norm: after the sub-layer)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="core">
          <mxGeometry x="45" y="250" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mlp" value="MLP (multi-layer perceptron) / feed-forward network, hidden width 2048, ReLU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="core">
