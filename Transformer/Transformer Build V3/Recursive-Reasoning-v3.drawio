        <mxCell id="core" value="&lt;b&gt;nn.TransformerEncoder&lt;/b&gt; (num_layers = 4)&lt;br&gt;same weights on every call" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fafafa;strokeColor=#000000;fontSize=14;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
