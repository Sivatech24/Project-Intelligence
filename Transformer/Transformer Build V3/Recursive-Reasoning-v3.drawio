        <mxCell id="slice_z" value="out[:, −1:]&lt;br&gt;→ z_out" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="572" y="640" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="head_y" value="&lt;b&gt;update_y_head&lt;/b&gt;&lt;br&gt;Linear(d, d)&lt;br&gt;y ← y + W·y_out" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
