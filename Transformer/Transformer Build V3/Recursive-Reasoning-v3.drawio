        </mxCell>
        <mxCell id="sched" value="&lt;b&gt;Per supervision step k&lt;/b&gt;&lt;br&gt;• T−1 cycles under no_grad&lt;br&gt;• last cycle with gradients&lt;br&gt;&lt;b&gt;Per cycle&lt;/b&gt;&lt;br&gt;• n × z ← f(a, x, y, z)&lt;br&gt;• 1 × y ← f(a, y, z)  (x dropped, as in the Tiny Recursive Model)&lt;br&gt;After the step: loss, backward, detach (y, z)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="core">
