        <mxCell id="v3" value="&lt;b&gt;Consistency&lt;/b&gt;&lt;br&gt;agreement across rotation and flip augmentations and across runs. A tie-breaker, never a substitute for the other two" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="ver">
