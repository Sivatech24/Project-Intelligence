        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;ARC mode&lt;/b&gt;&lt;br&gt;re-run on each train pair (leave-one-out); exact grid match required. Same test as find_rule() in ARC.py" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="ver">
