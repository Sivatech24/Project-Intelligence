        <mxCell id="logger" value="&lt;b&gt;Trajectory logger&lt;/b&gt; (no grad)&lt;br&gt;Ŷ_all = [ŷ_1 … ŷ_K] · q_1 … q_K · z_pool_1 … z_pool_K" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
