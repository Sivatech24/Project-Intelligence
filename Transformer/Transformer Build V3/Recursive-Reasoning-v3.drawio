  <diagram name="3 · Target v3 · training" id="page-v3-training">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#fafafa;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="1130" width="280" height="116" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;Target v3 — training step &amp; self-improvement loop&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=22;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="14" width="900" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="top → bottom · left: one supervision step · right: how verified data becomes better weights" style="text;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;1 · Sample&lt;/b&gt; (x, a, target) — a retrieved with as_of = the task’s date" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#cdeb8b;strokeColor=#36393d;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;2 · Init / carry&lt;/b&gt; (y, z) = learned init, or detached carry from step k−1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="220" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;3 · forward_step&lt;/b&gt;&lt;br&gt;T−1 cycles under no_grad, last cycle with grad&lt;br&gt;per cycle: n × z-update, then 1 × y-update (weights θ, latest promoted)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;4 · Losses at step k&lt;/b&gt;&lt;br&gt;cross-entropy(ŷ_k, target) · w_k — every step, discounted&lt;br&gt;+ binary cross-entropy(q_k, verifier_k) — halt head, external label&lt;br&gt;+ λ · L_ground(z_k, x) — contrastive: z stays close to its own x, far from other x" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="460" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;5 · backward + optimizer.step()&lt;/b&gt;&lt;br&gt;graph = one cycle, about 12 layer calls (not 192)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="620" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;6 · detach (y, z)&lt;/b&gt; → carry to step k + 1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="720" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="k &lt; N_sup and not halted?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="170" y="820" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;External Verifier&lt;/b&gt; labels every ŷ_k pass / fail&lt;br&gt;same checks as inference (facts · ARC training pairs · consistency)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Write gate&lt;/b&gt;&lt;br&gt;only externally verified outputs enter d_pass" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="260" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dp" value="&lt;b&gt;d_pass&lt;/b&gt;&lt;br&gt;verified (x, a, ŷ, z)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="390" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="df" value="&lt;b&gt;d_fail&lt;/b&gt;&lt;br&gt;hard negatives (quarantined)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="390" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Rejection-sampling supervised fine-tuning&lt;/b&gt;&lt;br&gt;on d_pass" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="550" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;Direct Preference Optimization&lt;/b&gt;&lt;br&gt;pairs (ŷ_pass ≻ ŷ_fail) on the same x" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="550" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;Candidate weights θ′&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="700" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="&lt;b&gt;Held-out gate&lt;/b&gt;&lt;br&gt;frozen held-out tasks, never written to any buffer. Promote θ′ only if pass-rate ↑ and hallucination-rate ↓ versus θ; otherwise discard θ′." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#e3f3e3;strokeColor=#4d8f4d;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="830" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="&lt;b&gt;Base model θ&lt;/b&gt; (≈ 27 million parameters) — used by forward_step next round" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="1000" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Linear probe&lt;/b&gt;&lt;br&gt;z_pool_k → pass / fail, trained on verifier labels (replaces Δz decoding)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="115" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Developer alert&lt;/b&gt;&lt;br&gt;probe score per iteration k · top-attended fact identifiers / tokens · failing claim identifiers" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="270" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;anomaly log&lt;/b&gt;&lt;br&gt;[query | k | probe score | failed claim IDs]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1520" y="440" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Why not Δz = z₃ − z₂?&lt;/b&gt;&lt;br&gt;Latents from different iterations and inputs are not directly comparable, and the reverse embedding cannot turn a latent difference into “the hallucinated tokens”. A probe on pooled z is measurable and testable." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1">
