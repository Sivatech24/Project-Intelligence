        <mxCell id="h_z" value="&lt;b&gt;z_pool&lt;/b&gt;&lt;br&gt;mean over z slots, detached" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
