        <mxCell id="head_z" value="&lt;b&gt;update_z_head&lt;/b&gt;&lt;br&gt;Linear(d, d)&lt;br&gt;z ← z + W·z_out" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="572" y="520" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rev" value="&lt;b&gt;reverse_embedding&lt;/b&gt;&lt;br&gt;Linear(d, vocab) → logits (B, vocab)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="297" y="400" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ce" value="&lt;b&gt;CrossEntropyLoss&lt;/b&gt;&lt;br&gt;final step only" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="297" y="280" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bw" value="&lt;b&gt;loss.backward()&lt;/b&gt;&lt;br&gt;graph = 16 × 3 × 4 = 192 layer calls" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="297" y="170" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="①" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#b85450;strokeColor=#7a2f2c;fontSize=13;fontColor=#ffffff;fontStyle=1;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="742" y="1217" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b2a" value="②" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#b85450;strokeColor=#7a2f2c;fontSize=13;fontColor=#ffffff;fontStyle=1;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="702" y="1387" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b2b" value="②" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#b85450;strokeColor=#7a2f2c;fontSize=13;fontColor=#ffffff;fontStyle=1;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1047" y="1387" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="③" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#b85450;strokeColor=#7a2f2c;fontSize=13;fontColor=#ffffff;fontStyle=1;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="584" y="157" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="④" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#b85450;strokeColor=#7a2f2c;fontSize=13;fontColor=#ffffff;fontStyle=1;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="584" y="267" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="⑤" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#b85450;strokeColor=#7a2f2c;fontSize=13;fontColor=#ffffff;fontStyle=1;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="367" y="1507" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;① No positional or type embeddings.&lt;/b&gt; nn.TransformerEncoder is permutation-equivariant, so x, y and z tokens are told apart only by their content. Add a learned type embedding (x / y / z / a) and a position signal (RoPE, or 2-D for grids)." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="120" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;② y and z are single tokens.&lt;/b&gt; One token can only produce one class from reverse_embedding. An ARC output is a grid (up to 30×30 = 900 cells), so y needs S_out tokens and z needs m latent tokens (for example 16–64)." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="254" width="440" height="93" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;③ Full backprop through every loop.&lt;/b&gt; The graph spans 16 × (2 + 1) × 4 = 192 layer applications at the defaults, and memory grows linearly with N_sup. Fix: deep supervision — backprop one cycle, detach (y, z), repeat." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="371" width="440" height="93" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;④ Loss only at the end.&lt;/b&gt; y gets no signal at intermediate steps and there is no halting signal. Add a per-step CE and a halt head trained on a verifier label." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="488" width="440" height="77" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;⑤ Dummy data, not connected to ARC.&lt;/b&gt; __main__ trains on torch.randint tokens with random labels, so there is nothing to learn. The ARC solvers (ARC.py rule search, Build3 test-time CNN) are separate files with no link to this model. Needs a grid → token pipeline." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="589" width="440" height="110" as="geometry" />
        </mxCell>
