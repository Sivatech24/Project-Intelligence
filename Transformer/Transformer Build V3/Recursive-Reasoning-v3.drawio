        </mxCell>
        <mxCell id="an2" value="Add &amp; Normalize" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="core">
          <mxGeometry x="45" y="90" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="slice_y" value="out[:, −2:−1]&lt;br&gt;→ y_out" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="337" y="640" width="220" height="60" as="geometry" />
