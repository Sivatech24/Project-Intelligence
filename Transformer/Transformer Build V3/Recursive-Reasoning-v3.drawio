          <mxGeometry x="330" y="14" width="900" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="ARC/Build_Base_Recursive_Transformer_Architecture/RTA.py · defaults d_model=512 (model width), 8 attention heads, 4 layers, N_sup=16 (supervision loops), n_inner=2 (latent updates) · B = batch size, S = question length · data flows bottom → top" style="text;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="130" y="60" width="1300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="good" value="&lt;b&gt;Already fixed vs. the old diagram&lt;/b&gt;&lt;br&gt;• x is re-concatenated on every pass (no one-shot “+”), so no latent drift from a lost input&lt;br&gt;• redundant Attn / FFN stack is gone (standard encoder layer)&lt;br&gt;• z-then-y two-phase update is implemented&lt;br&gt;• the old diagram’s “+” is torch.cat in the code" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#e3f3e3;strokeColor=#4d8f4d;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="255" height="250" as="geometry" />
        </mxCell>
        <mxCell id="sched" value="for s in 1..N_sup:&lt;br&gt;&amp;nbsp;&amp;nbsp;for i in 1..n_inner:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;z ← z + W_z·core(x,y,z)[z]&lt;br&gt;&amp;nbsp;&amp;nbsp;y ← y + W_y·core(x,y,z)[y]&lt;br&gt;logits = reverse_embedding(y)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="170" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="x_ids" value="&lt;b&gt;x&lt;/b&gt; · token ids&lt;br&gt;(B, S)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffff88;strokeColor=#36393d;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="1520" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="nn.Embedding(vocab, d_model)&lt;br&gt;x_emb (B, S, d)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="1400" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="y0" value="initial_y (learned 1×1×d)&lt;br&gt;expand → (B, 1, d)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="415" y="1400" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="z0" value="initial_z (learned 1×1×d)&lt;br&gt;expand → (B, 1, d)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="1400" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="concat" value="&lt;b&gt;torch.cat([x_emb, y, z], dim=1)&lt;/b&gt;&lt;br&gt;(B, S+2, d)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="365" y="1230" width="400" height="80" as="geometry" />
